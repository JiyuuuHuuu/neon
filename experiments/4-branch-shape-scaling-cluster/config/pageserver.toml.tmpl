listen_pg_addr    = "0.0.0.0:64000"
listen_http_addr  = "0.0.0.0:9898"
pg_distrib_dir    = "__REMOTE_BIN__/pg_install"
broker_endpoint   = "http://__STORCON_IP__:50051"
control_plane_api = "http://__STORCON_IP__:1234/upcall/v1/"
availability_zone = "lan"

remote_storage = { local_path = "__REMOTE_HOME__/ps-remote" }

max_file_descriptors = 32768
page_cache_size      = 1048576
disk_usage_based_eviction = { enabled = false }

[tenant_config]
gc_period          = "0s"
compaction_period  = "0s"
pitr_interval      = "0s"
gc_horizon         = 0
checkpoint_timeout = "10years"
lsn_lease_length   = "0s"
heatmap_period     = "0s"
